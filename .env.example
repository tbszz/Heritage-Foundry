PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 兼容旧部署；设置 CORS_ALLOWED_ORIGINS 后优先使用新名称
ALLOWED_ORIGINS=
TRUST_PROXY=false
API_JSON_BODY_LIMIT=15mb
API_FORM_BODY_LIMIT=1mb
IMAGE_RATE_LIMIT_MAX=12
IMAGE_RATE_LIMIT_WINDOW_MS=600000
# 兼容旧部署中的生图限流变量
GENERATE_RATE_MAX=
GENERATE_RATE_WINDOW_MS=
THREE_D_RATE_LIMIT_MAX=4
THREE_D_RATE_LIMIT_WINDOW_MS=900000
THREE_D_STATUS_RATE_LIMIT_MAX=120
THREE_D_STATUS_RATE_LIMIT_WINDOW_MS=60000
# Serverless 内存限流仅为单实例的尽力保护；线上仍应配置 Meshy 账户额度或网关级配额。
THREE_D_CAPABILITY_RATE_LIMIT_MAX=30
THREE_D_CAPABILITY_RATE_LIMIT_WINDOW_MS=60000
THREE_D_CAPABILITY_CACHE_MS=5000
THREE_D_PROVIDER=meshy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image
# Vercel/线上：只支持 Meshy；未配置时能力接口会返回 configured=false
MESHY_API_KEY=
MESHY_API_BASE_URL=https://api.meshy.ai/openapi/v1
MESHY_TIMEOUT_MS=30000
# 云端 Tripo API：设置 THREE_D_PROVIDER=tripo 后启用。API Key 仅放服务端环境变量。
TRIPO_API_KEY=
TRIPO_API_BASE_URL=https://openapi.tripo3d.ai/v3
TRIPO_TIMEOUT_MS=30000
TRIPO_MODEL=v3.1-20260211
TRIPO_FACE_LIMIT=10000
TRIPO_TEXTURE_QUALITY=detailed
TRIPO_GEOMETRY_QUALITY=detailed
TRIPO_MAX_IMAGE_BYTES=20971520
# 本地/离线：设置 THREE_D_PROVIDER=local 后启用以下 TripoSR sidecar 配置
LOCAL_3D_BASE_URL=http://127.0.0.1:7861
LOCAL_3D_API_KEY=
LOCAL_3D_TIMEOUT_MS=30000
LOCAL_3D_ALLOWED_HOSTS=127.0.0.1,localhost,::1,[::1]
LOCAL_3D_MAX_IMAGE_BYTES=10485760
LOCAL_3D_MAX_MODEL_BYTES=104857600
TRIPOSR_REPO_PATH=D:\HeritageFoundry3D\TripoSR
TRIPOSR_MODEL_ID=D:\HeritageFoundry3D\models\TripoSR
TRIPOSR_ARTIFACT_DIR=D:\HeritageFoundry3D\artifacts
TRIPOSR_DEVICE=cuda:0
TRIPOSR_CHUNK_SIZE=4096
TRIPOSR_MC_RESOLUTION=160
TRIPOSR_TARGET_HEIGHT_M=0.18
TRIPOSR_MAX_TASKS=100
TRIPOSR_MAX_QUEUE_SIZE=2
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Require visually reviewed references for museum commissioning
TRIPO_REQUIRE_REFERENCES=true
# Optional shared private batch ledger directory
TRIPO_BATCH_DIR=
