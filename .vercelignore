# Only upload the application sources required by the Vite build and Vercel
# Serverless Functions. This also keeps local secrets, submission exports,
# design references, test artifacts, and generated previews out of deployments.
/*
!api
!middleware
!routes
!services
!src
!public
!package.json
!package-lock.json
!vite.config.js
!vercel.json
!.vercelignore

# Test files under api/ would otherwise be interpreted as Serverless Functions.
api/*.test.js
api/**/*.test.js

# Local/offline TripoSR runtime. Vercel uses the Meshy provider only.
sidecar/
.local-3d/
artifacts/
models/TripoSR/

# Original heavyweight assets are not needed by the Vite build; compressed
# runtime assets remain under public/models/.
assets-src/models/

# Local demonstration exports are deliberately kept outside source control.
heritage-foundry-demo.zip
